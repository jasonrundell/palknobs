{
  "name": "palknobs",
  "private": true,
  "version": "1.0.0",
  "description": "Local desktop app for editing Palworld dedicated server settings (PalWorldSettings.ini) through a friendly UI.",
  "author": "Jason Rundell",
  "license": "MIT",
  "homepage": "https://github.com/jasonrundell/palknobs#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jasonrundell/palknobs.git"
  },
  "bugs": {
    "url": "https://github.com/jasonrundell/palknobs/issues"
  },
  "keywords": [
    "palworld",
    "palserver",
    "dedicated-server",
    "game-server",
    "settings-editor",
    "electron"
  ],
  "type": "module",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "concurrently -n api,web -c green,cyan \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "tsx server/start.ts",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "start": "tsx server/start.ts",
    "electron:compile": "tsc -p tsconfig.electron.json",
    "electron:dev": "npm run electron:compile && concurrently -k -n web,electron -c cyan,magenta \"npm run dev:web\" \"wait-on tcp:5173 && cross-env ELECTRON_DEV=1 electron .\"",
    "electron:start": "npm run build && npm run electron:compile && electron .",
    "electron:build": "npm run build && npm run electron:compile && electron-builder --win --publish never",
    "electron:build:dir": "npm run build && npm run electron:compile && electron-builder --win --dir"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^7.2.0",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "concurrently": "^10.0.3",
    "cross-env": "^7.0.3",
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8",
    "oxlint": "^1.71.0",
    "supertest": "^7.2.2",
    "tsx": "^4.23.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.jasonrundell.palknobs",
    "productName": "PalKnobs",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
