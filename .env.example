# PalKnobs — environment overrides
#
# Copy this file to `.env` and uncomment/edit as needed. `.env` is gitignored.
# Both variables are OPTIONAL: without them the app uses its default PalServer
# path and lets you set the settings file from the app UI.

# Override the PalServer install root. The settings file is then derived as
# <root>/Pal/Saved/Config/WindowsServer/PalWorldSettings.ini
#PALSERVER_ROOT=C:\Program Files (x86)\Steam\steamapps\common\PalServer

# Override the full path to PalWorldSettings.ini directly. When set, this wins
# over PALSERVER_ROOT and the app UI cannot change the settings-file path.
#PALSERVER_SETTINGS_PATH=C:\Program Files (x86)\Steam\steamapps\common\PalServer\Pal\Saved\Config\WindowsServer\PalWorldSettings.ini
